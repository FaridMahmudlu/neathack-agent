# neatlogs Project API key (ingest — trace GÖNDƏRMƏK üçün)
# Dashboard → Settings → API keys → "Project API key" (yuxarıdakı; nlw_ ilə başlayan DEYİL)
NEATLOGS_API_KEY=

# neatlogs Public API (trace OXUMAQ üçün — debugger agentin aləti)
# Settings → Service Accounts → create → bind project → mint token
# scopes: context:read + observability:read
NEATLOGS_TOKEN=
NEATLOGS_PROJECT_ID=

# neatHack LiteLLM proxy — komandanın $20 model krediti
# https://neatlogs.com/hackathon/models
LITELLM_API_KEY=

# Alternativlər (hansı olsa doldur)
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# AWS Bedrock (hackathon AWS kreditləri gələndə)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
